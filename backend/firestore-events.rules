// Eventos globais - blocos para as regras do Firestore (Console > Firestore > Regras).
// Colar dentro de service cloud.firestore { match /databases/{database}/documents { ... } }
//
// Quem pode comecar eventos decide-se AQUI, nao no jogo: basta criar, no Console, um documento
// vazio em /admins/{uid} com o uid da conta que fica com o poder (e apagar para o tirar).
// O jogo so mostra os botoes a quem este documento existir, mas mesmo que alguem forcasse o
// pedido, o servidor recusa-o sem o documento.

function isAdmin() {
  return request.auth != null
      && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
}

match /admins/{uid} {
  // cada conta so pode ver a sua (e so para saber se e admin); escrever e' so pelo Console
  allow get: if request.auth != null && request.auth.uid == uid;
  allow list, write: if false;
}

match /events/current {
  // toda a gente le: e' assim que o bonus chega a todos os jogadores online
  allow read: if true;
  allow create, update: if isAdmin()
      && request.resource.data.keys().hasOnly(['kind', 'mult', 'ends_at', 'by'])
      && request.resource.data.kind in ['luck', 'money', 'speed']
      && request.resource.data.mult is number
      && request.resource.data.mult >= 1 && request.resource.data.mult <= 100
      && request.resource.data.ends_at is timestamp
      // no maximo uma hora de cada vez (um evento esquecido acaba sozinho)
      && request.resource.data.ends_at > request.time
      && request.resource.data.ends_at < request.time + duration.value(3600, 's');
  allow delete: if isAdmin();
}
