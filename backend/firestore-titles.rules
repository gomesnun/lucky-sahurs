// ---- Titles (Rust version, v2.9.1+): the title each player equipped, seen by everyone logged in ----
// Paste INSIDE "match /databases/{database}/documents { ... }", next to the other blocks (it uses isAdmin(),
// which the full rules file already defines). Only the account itself writes its title, and only an admin
// can wear "owner". The game keeps working without this block: titles just aren't saved or shown.
match /titles/{uid} {
  allow read: if request.auth != null;
  allow create, update: if request.auth != null && request.auth.uid == uid
                        && request.resource.data.keys().hasOnly(['title'])
                        && request.resource.data.title is string
                        && request.resource.data.title.size() <= 32
                        && (request.resource.data.title != 'owner' || isAdmin());
  allow delete: if request.auth != null && request.auth.uid == uid;
}
