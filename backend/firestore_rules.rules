rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Saves: cada conta só vê e mexe nos SEUS slots ----
    match /users/{uid}/saves/{slot} {
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['coins', 'total_earned', 'playtime', 'rolls', 'rebirths', 'data'])
            // "rebirths" é opcional: versões antigas do jogo não o enviam e continuam a poder gravar
            && d.keys().hasAll(['coins', 'total_earned', 'playtime', 'rolls', 'data'])
            && d.coins is number && d.total_earned is number
            && d.playtime is number && d.rolls is number
            && d.coins >= 0 && d.total_earned >= 0 && d.playtime >= 0 && d.rolls >= 0
            && (!('rebirths' in d) || (d.rebirths is int && d.rebirths >= 0 && d.rebirths <= 1000))
            && d.data is string && d.data.size() < 900000;
      }
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && slot in ['slot1', 'slot2', 'slot3']
                            && validSave();
    }
    // ---- Sessão: uma conta, um jogo de cada vez ----
    // Marca de "estou a jogar", renovada de 30 em 30 s pelo jogo. Só o dono a vê e a escreve, e só se
    // pode tirar a marca a outro PC se ele já a largou (active = false) ou se deixou de a renovar há mais
    // de 90 s (SESSION_STALE no online/firebase.py — os dois valores têm de ser iguais).
    match /users/{uid}/session/current {
      function validLock() {
        let d = request.resource.data;
        return d.keys().hasOnly(['session_id', 'active', 'heartbeat'])
            && d.keys().hasAll(['session_id', 'active', 'heartbeat'])
            // nome da instalação: o jogo usa 32 caracteres hexadecimais (uuid4)
            && d.session_id is string && d.session_id.matches('[A-Za-z0-9_-]{8,64}')
            && d.active is bool
            // a hora tem de ser a do servidor: assim não dá para fingir uma marca fresca (para trancar
            // a conta a alguém) nem uma marca velha (para roubar a marca a quem está mesmo a jogar)
            && d.heartbeat == request.time;
      }
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && validLock();
      allow update: if request.auth != null && request.auth.uid == uid && validLock()
                    && (resource.data.session_id == request.resource.data.session_id
                        || resource.data.active == false
                        || request.time > resource.data.heartbeat + duration.value(90, 's'));
      // apagar não: um "delete" não traz session_id nenhum, por isso não havia forma de distinguir
      // quem larga a sua marca de quem estava a limpar a marca de outro para entrar por cima
      allow delete: if false;
    }
    // ---- Leaderboard: toda a gente lê, cada conta escreve só a sua linha ----
    match /leaderboard/{uid} {
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['username', 'coins', 'playtime', 'rolls', 'rebirths', 'prestige', 'updated_at'])
            // "rolls" e "rebirths" são opcionais: uma versão antiga do jogo continua a publicar dinheiro/tempo
            && d.keys().hasAll(['username', 'coins', 'playtime', 'updated_at'])
            // o nome tem de ser o da própria conta (o email interno é <username>@luckysahurs.invalid)
            && d.username is string
            // mesmo formato que o jogo aceita: 3 a 16 letras minúsculas, números ou _
            && d.username.matches('[a-z0-9_]{3,16}')
            // NOTA: já não se compara com request.auth.token.email - depois de uma conta associar e
            // verificar um email a sério (ver online/firebase.py change_login_email), o token passa a
            // trazer ESSE email em vez do <username>@luckysahurs.invalid, e esta comparação bloqueava
            // sempre a escrita. O dono já está garantido por uid == {uid} no caminho do documento.
            // Sem anti-cheat (dinheiro / rolls / rebirths comparados com o tempo jogado): com os admin abuses as
            // contas passavam esses limites, a publicação era recusada e a linha ficava presa no mesmo valor.
            // Agora só se confirmam os tipos. Para tirar alguém da leaderboard, usa os Bans (Admin commands).
            && d.coins is number && d.coins >= 0
            && d.playtime is number && d.playtime >= 0
            && (!('rolls' in d) || (d.rolls is int && d.rolls >= 0))
            && (!('rebirths' in d) || (d.rebirths is int && d.rebirths >= 0))
            // v3.0: o Prestígio (1 a 5), opcional - só é enviado depois do primeiro
            && (!('prestige' in d) || (d.prestige is int && d.prestige >= 1 && d.prestige <= 5))
            // a hora tem de ser a do servidor (não dá para falsificar)
            && d.updated_at == request.time;
      }
      allow read: if true;
      // contas banidas (/bans/{uid}, ver em baixo) não publicam; o admin apaga a linha delas ao banir
      allow create: if request.auth != null && request.auth.uid == uid && validEntry()
                    && !exists(/databases/$(database)/documents/bans/$(uid));
      // sem limite de tempo (v3.0.1): o jogo já só publica de 10 em 10 minutos, e os batoteiros resolvem-se
      // com os Bans do menu de admin
      allow update: if request.auth != null && request.auth.uid == uid && validEntry()
                    && !exists(/databases/$(database)/documents/bans/$(uid));
      allow delete: if isAdmin();
    }
    // ---- Perfil da conta: email por confirmar/confirmado + código de 6 dígitos pendente ----
    match /users/{uid}/account/profile {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'email_verified', 'pending_code', 'code_created'])
            && d.keys().hasAll(['email', 'email_verified', 'pending_code'])
            && d.email is string && d.email.size() < 200
            && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
            && d.email_verified is bool
            && d.pending_code is string && d.pending_code.matches('([0-9]{6})?');
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validProfile();
      allow delete: if false;
    }
    // ---- Mapa username -> email de login ATUAL da conta (para o login por username continuar a
    // funcionar depois de trocarmos o email falso pelo verdadeiro). Leitura pública (é preciso para
    // resolver o login antes de teres sessão), escrita só por quem provar (pelo email falso no token)
    // que é mesmo o dono desse username. ----
    match /usernames/{username} {
      function validMap() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'email'])
            && d.keys().hasAll(['uid', 'email'])
            && d.uid is string && d.uid == request.auth.uid
            && d.email is string && d.email.size() < 200
            && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
            && request.auth.token.email == username + '@luckysahurs.invalid';
      }
      allow read: if true;
      allow create: if request.auth != null && validMap();
      allow update: if request.auth != null && validMap() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    // ---- Amigos: perfil público, pedidos e lista de amigos ----
    // Perfil público: username + a foto (um verity que o jogador tem).
    // Qualquer pessoa autenticada pode ler (é assim que se procura um amigo pelo nome);
    // escrever, só o dono. Fica à parte de /usernames/{username}, que guarda o email de login.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      // last_seen = "está a jogar agora" (o jogo renova-o de 2 em 2 min; os amigos veem quem está online).
      // Tem de ser a hora do servidor, para ninguém ficar "online" para sempre.
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['username', 'avatar_pet', 'avatar_mut', 'updated_at', 'last_seen'])
                   && request.resource.data.avatar_pet is int
                   && request.resource.data.avatar_mut in ['normal', 'golden', 'diamond', 'rainbow']
                   && (!('last_seen' in request.resource.data) || request.resource.data.last_seen == request.time);
    }

    // ---- Leaderboard partilhada: uma fotografia por período, para toda a gente ----
    // Só o script (backend/apps_script/Leaderboard.gs, com a conta dona do projeto) escreve aqui; essa
    // conta passa por cima destas regras. Os jogadores só leem (1 leitura em vez de até 200).
    match /public/leaderboard {
      allow read: if true;
      allow write: if false;
    }

    // v3.0.1: a temporada. Um admin sobe o número (menu de admin > "Reset everyone") e cada jogo apaga os
    // saves de temporadas anteriores. Só pode subir de 1 em 1.
    match /public/season {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['season'])
                    && request.resource.data.season == 1;
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['season'])
                    && request.resource.data.season == resource.data.season + 1;
      allow delete: if false;
    }

    // v3.0.1: recomeçar UM jogador. O admin sobe o número em /resets/{uid}; o jogo desse jogador apaga os saves
    // com um número mais baixo. Só o próprio (e os admins) o leem; só os admins o escrevem, de 1 em 1.
    match /resets/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['n'])
                    && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Pedidos de amizade. O id é "<uid de destino>__<uid de origem>": assim o mesmo pedido
    // nunca aparece duas vezes e a própria regra confirma quem o está a criar.
    match /friend_requests/{pedido} {
      allow read: if request.auth != null
                  && (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.from_uid == request.auth.uid
                    && request.resource.data.to_uid != request.auth.uid
                    && pedido == request.resource.data.to_uid + '__' + request.auth.uid;
      // apagar: quem recebeu (recusar / aceitar) ou quem enviou (desistir)
      allow delete: if request.auth != null
                    && (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid);
      allow update: if false;
    }

    // Lista de amigos de cada conta. Só o dono a lê; escrever pode ser o dono (remover) ou o
    // próprio amigo (ao aceitar um pedido escreve-se nas duas listas de uma vez).
    match /users/{uid}/friends/{amigo} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && (request.auth.uid == uid || request.auth.uid == amigo);
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == amigo);
    }

    // ================= Feedback (um recado por conta) =================

    match /feedback/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['username', 'text', 'updated_at'])
                            && request.resource.data.username is string
                            && request.resource.data.username.matches('[a-z0-9_]{3,16}')
                            // NOTA: já não se compara com request.auth.token.email - depois de uma conta
                            // associar e verificar um email a sério (ver online/firebase.py
                            // change_login_email), o token passa a trazer ESSE email em vez do
                            // <username>@luckysahurs.invalid, e esta comparação bloqueava sempre a escrita
                            // (é exatamente o "The server refused this" no Feedback). O dono já está
                            // garantido por uid == {uid} no caminho do documento (/feedback/{uid}).
                            && request.resource.data.text is string
                            && request.resource.data.text.size() >= 4
                            && request.resource.data.text.size() <= 280
                            // a hora tem de ser a do servidor (não dá para falsificar)
                            && request.resource.data.updated_at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ================= Chat entre amigos =================

    function chatMember(cid) {
      // "uidA__uidB" -> o uid de quem está autenticado tem de ser uma das duas metades
      return request.auth != null
          && cid.split('__').hasAny([request.auth.uid]);
    }

    match /chats/{cid} {
      // documento-resumo da conversa: last_at / last_from (usado para o ponto de mensagem nova)
      allow read: if chatMember(cid);
      allow create, update: if chatMember(cid)
          && request.resource.data.keys().hasOnly(['last_at', 'last_from'])
          && request.resource.data.last_from == request.auth.uid
          && request.resource.data.last_at == request.time;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if chatMember(cid);
        allow create: if chatMember(cid)
            && request.resource.data.keys().hasOnly(['from_uid', 'to_uid', 'text', 'sent_at'])
            && request.resource.data.from_uid == request.auth.uid
            && cid.split('__').hasAll([request.resource.data.from_uid, request.resource.data.to_uid])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 280
            && request.resource.data.sent_at == request.time;
        // as mensagens não se editam nem se apagam
        allow update, delete: if false;
      }
    }

    // ================= Eventos globais (admin) =================

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // cada conta so pode ver a sua (e so para saber se e admin); escrever e' so pelo Console
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---- Bans: só os admins banem / desbanem / veem a lista; cada conta pode ler o SEU (para saber que
    // está banida e porquê). Desbanir = apagar o documento: a conta volta a jogar normalmente.
    match /bans/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['username', 'reason', 'by', 'at'])
          && request.resource.data.username is string
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
          && request.resource.data.by is string
          && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }

    match /events/{kind} {
      // toda a gente le (get e list): e' assim que o bonus chega a todos os jogadores online.
      // cada tipo (luck/money/speed) e' o SEU PROPRIO documento, por isso os tres podem estar
      // a decorrer ao mesmo tempo - comecar ou parar um nunca toca nos outros.
      allow read: if true;
      allow create, update: if isAdmin()
          && kind in ['luck', 'money', 'speed']
          // o tipo ja vem no caminho do documento (/events/luck, /events/money, /events/speed);
          // o cliente ja nao envia um campo "kind" repetido, por isso a regra tambem nao o pode exigir
          && request.resource.data.keys().hasOnly(['mult', 'ends_at', 'by'])
          && request.resource.data.mult is number
          && request.resource.data.mult >= 1 && request.resource.data.mult <= 1000000
          && request.resource.data.ends_at is timestamp
          // no maximo 24 horas de cada vez (um evento esquecido acaba sozinho); +2 min de folga para o
          // relogio do PC (o jogo usa a hora do servidor, mas pode falhar por uns segundos)
          && request.resource.data.ends_at > request.time
          && request.resource.data.ends_at < request.time + duration.value(86520, 's');
      allow delete: if isAdmin();
    }

    // ================= Trocas de pets (entre amigos) =================
    // Sem Cloud Functions: quem valida tudo é a própria regra, lendo outros documentos com get()/exists().
    // Três peças:
    //   /users/{uid}/wallet/pets   - a carteira online (cópia do "owned" do save, só para as trocas)
    //   /trades/{tradeId}          - um pedido de troca pendente
    //   /users/{uid}/incoming/{id} - o "recibo" que fica à espera de ser aplicado do lado de quem propôs

    function tradeItemKeys(prefix) {
      return [prefix + '_key1', prefix + '_qty1', prefix + '_key2', prefix + '_qty2',
              prefix + '_key3', prefix + '_qty3'];
    }

    function tradeItemTypesOk(data, prefix) {
      return data[prefix + '_key1'] is string && data[prefix + '_qty1'] is int && data[prefix + '_qty1'] >= 0
          && data[prefix + '_key2'] is string && data[prefix + '_qty2'] is int && data[prefix + '_qty2'] >= 0
          && data[prefix + '_key3'] is string && data[prefix + '_qty3'] is int && data[prefix + '_qty3'] >= 0;
    }

    function tradeItemNotEmpty(data, prefix) {
      return data[prefix + '_qty1'] > 0 || data[prefix + '_qty2'] > 0 || data[prefix + '_qty3'] > 0;
    }

    // "tenho mesmo o que estou a oferecer" - lê a MINHA carteira e confirma slot a slot.
    function walletCovers(wallet, data, prefix) {
      return (data[prefix + '_qty1'] == 0 || wallet.get(data[prefix + '_key1'], 0) >= data[prefix + '_qty1'])
          && (data[prefix + '_qty2'] == 0 || wallet.get(data[prefix + '_key2'], 0) >= data[prefix + '_qty2'])
          && (data[prefix + '_qty3'] == 0 || wallet.get(data[prefix + '_key3'], 0) >= data[prefix + '_qty3']);
    }

    match /users/{uid}/wallet/pets {
      // "read" e "write" à parte: request.resource só existe em pedidos de escrita (create/update),
      // por isso juntar as duas condições numa só fazia toda a leitura dar erro na regra (e uma regra
      // com erro conta sempre como recusada).
      // leitura: QUALQUER conta autenticada, não só o dono - para propores uma troca é preciso ver a
      // carteira do teu amigo (get_wallet(uid_dele) em online/firebase.py). Só tem contagens de pets,
      // nada sensível.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['owned'])
          && request.resource.data.owned is map;
    }

    match /trades/{tradeId} {
      allow read, delete: if request.auth != null
          && (resource.data.from_uid == request.auth.uid || resource.data.to_uid == request.auth.uid);

      allow create: if request.auth != null
          && request.resource.data.from_uid == request.auth.uid
          && request.resource.data.to_uid != request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['from_uid', 'to_uid'].concat(tradeItemKeys('offer')).concat(tradeItemKeys('request')))
          && tradeItemTypesOk(request.resource.data, 'offer')
          && tradeItemTypesOk(request.resource.data, 'request')
          && tradeItemNotEmpty(request.resource.data, 'offer')
          && tradeItemNotEmpty(request.resource.data, 'request')
          // só amigos: tens de ter o outro na tua lista de amigos
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to_uid))
          // confirma, pela carteira, que tens mesmo o que estás a oferecer
          && walletCovers(get(/databases/$(database)/documents/users/$(request.auth.uid)/wallet/pets).data.owned,
                           request.resource.data, 'offer');

      // uma troca nunca se atualiza: ou é aceite (apaga-se + cria-se um recibo), ou é cancelada/recusada
      allow update: if false;
    }

    match /users/{uid}/incoming/{tradeId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // só pode ser criado por quem aceitou a troca (to_uid), copiando EXATAMENTE a troca que existia
      allow create: if request.auth != null && request.auth.uid != uid
          && get(/databases/$(database)/documents/trades/$(tradeId)).data.from_uid == uid
          && get(/databases/$(database)/documents/trades/$(tradeId)).data.to_uid == request.auth.uid
          && request.resource.data.keys().hasOnly(tradeItemKeys('give').concat(tradeItemKeys('take')))
          && request.resource.data.give_key1 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_key1
          && request.resource.data.give_qty1 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_qty1
          && request.resource.data.give_key2 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_key2
          && request.resource.data.give_qty2 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_qty2
          && request.resource.data.give_key3 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_key3
          && request.resource.data.give_qty3 == get(/databases/$(database)/documents/trades/$(tradeId)).data.offer_qty3
          && request.resource.data.take_key1 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_key1
          && request.resource.data.take_qty1 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_qty1
          && request.resource.data.take_key2 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_key2
          && request.resource.data.take_qty2 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_qty2
          && request.resource.data.take_key3 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_key3
          && request.resource.data.take_qty3 == get(/databases/$(database)/documents/trades/$(tradeId)).data.request_qty3;

      allow update: if false;
    }

    // ---- Títulos (v3.0): o título que cada jogador equipou; só o dono escreve, "owner" só para admins ----
    match /titles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['title'])
                            && request.resource.data.title is string
                            && request.resource.data.title.size() <= 32
                            && (request.resource.data.title != 'owner' || isAdmin());
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // NOTA: as stats de um amigo vêm da /leaderboard/{uid}, que já é pública para leitura.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
